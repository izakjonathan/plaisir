    "page": "story",
    "section": "growth-section gold-section",
    "label": "Text",
    "kind": "text",
    "default": "**Readiness**Suppliers, paid rota, service standards and practical training.",
    "multiline": true
  },
  {
    "id": "story.page.text28",
    "page": "story",
    "section": "growth-section gold-section",
    "label": "Text",
    "kind": "text",
    "default": "**Soft opening**Service trials and a controlled opening period.",
