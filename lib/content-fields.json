    "page": "numbers",
    "section": "Funding overview",
    "label": "Paragraph",
    "kind": "text",
    "default": "The 10% allocation does not establish runway. A monthly cash-flow forecast must cost deposits, launch losses, supplier timing, delays and the minimum opening reserve.",
    "multiline": true
  },
  {
    "id": "numbers.page.text27",
    "page": "numbers",
    "section": "Funding overview",
    "label": "Paragraph",
    "kind": "text",
    "default": "Source percentages are proposals. Final funding depends on the approved site and complete opening budget. No cash balance, confirmed runway or payback is established.",
    "multiline": true
  },
