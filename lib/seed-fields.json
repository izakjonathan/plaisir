  {"id": "seed.swot.chapter", "page": "seed", "section": "swot", "label": "Slide label", "kind": "text", "default": "Appendix · SWOT analysis"},
  {"id": "seed.swot.heading", "page": "seed", "section": "swot", "label": "Slide heading", "kind": "text", "default": "SWOT analysis."},
  {"id": "seed.swot.p.1", "page": "seed", "section": "swot", "label": "Paragraph 1", "kind": "text", "default": "The flagship has to prove that two repeat occasions work at the same address."},
  {"id": "seed.swot.quadrant.1.label", "page": "seed", "section": "swot", "label": "Strengths label", "kind": "text", "default": "Strengths"},
  {"id": "seed.swot.quadrant.1.lead", "page": "seed", "section": "swot", "label": "Strengths highlight", "kind": "text", "default": "Two reasons to return."},
  {"id": "seed.swot.quadrant.1.text", "page": "seed", "section": "swot", "label": "Strengths description", "kind": "text", "default": "Fast specialty coffee and breakfast give commuters a weekday ritual. Guided wine by the glass and shareable boards give neighbours a reason to return after work. The workflow and training cover the shift from quick counter service to personal evening service. An assembly-led menu limits kitchen complexity."},
  {"id": "seed.swot.quadrant.2.label", "page": "seed", "section": "swot", "label": "Weaknesses label", "kind": "text", "default": "Weaknesses"},
  {"id": "seed.swot.quadrant.2.lead", "page": "seed", "section": "swot", "label": "Weaknesses highlight", "kind": "text", "default": "{visits} vs {breakEvenVisits} paid visits/day."},
  {"id": "seed.swot.quadrant.2.text", "page": "seed", "section": "swot", "label": "Weaknesses description", "kind": "text", "default": "The first is the established base case. The second is Year 2 EBITDA break-even at the modelled spend, mix and staffing. Free cash flow stays negative in all three base-case years. Site-specific demand is untested, and 40 seats is a design target."},
  {"id": "seed.swot.quadrant.3.label", "page": "seed", "section": "swot", "label": "Opportunities label", "kind": "text", "default": "Opportunities"},
  {"id": "seed.swot.quadrant.3.lead", "page": "seed", "section": "swot", "label": "Opportunities highlight", "kind": "text", "default": "Turn coffee regulars into wine regulars."},
  {"id": "seed.swot.quadrant.3.text", "page": "seed", "section": "swot", "label": "Opportunities description", "kind": "text", "default": "Coffee-and-pastry pairings can build morning frequency. Staff recommendations, tastings and neighbourhood partnerships can bring guests back in the evening. Loyalty can track how often they return across dayparts."},
  {"id": "seed.swot.quadrant.4.label", "page": "seed", "section": "swot", "label": "Threats label", "kind": "text", "default": "Threats"},
  {"id": "seed.swot.quadrant.4.lead", "page": "seed", "section": "swot", "label": "Threats highlight", "kind": "text", "default": "{eveningShare}% of modelled sales come from afternoon and evening wine and food."},
  {"id": "seed.swot.quadrant.4.text", "page": "seed", "section": "swot", "label": "Threats description", "kind": "text", "default": "East Village cafés and bars already compete for coffee, all-day social visits and evening wine. Lower traffic and higher opening costs put the cash reserve at risk."},
  {"id": "seed.swot-validation.chapter", "page": "seed", "section": "swot-validation", "label": "Slide label", "kind": "text", "default": "Appendix · SWOT and validation"},
  {"id": "seed.swot-validation.heading", "page": "seed", "section": "swot-validation", "label": "Slide heading", "kind": "text", "default": "What to prove before a lease."},
  {"id": "seed.swot-validation.p.1", "page": "seed", "section": "swot-validation", "label": "Paragraph 1", "kind": "text", "default": "Paid visits per day at established trade, with net spend per visit at opening prices. Wine and food includes afternoon and evening service."},
  {"id": "seed.swot-validation.p.2", "page": "seed", "section": "swot-validation", "label": "Paragraph 2", "kind": "text", "default": "Count traffic at candidate addresses. Use paid pop-ups to test purchase volumes, actual checks, morning service speed, evening labour needs and how many guests return across dayparts."},
  {"id": "seed.swot-validation.p.3", "page": "seed", "section": "swot-validation", "label": "Paragraph 3", "kind": "text", "default": "Plaisir Investor Forecast, pp. 2 and 5. Flagship sales exclude membership, private events, catering, retail wine, franchising and expansion."},
  {"id": "seed.swot-validation.h3.1", "page": "seed", "section": "swot-validation", "label": "Subheading 1", "kind": "text", "default": "Measure demand and service"},
  {"id": "seed.swot-validation.h3.2", "page": "seed", "section": "swot-validation", "label": "Subheading 2", "kind": "text", "default": "Stress-test the cash reserve"},
  {"id": "seed.swot-validation.stress", "page": "seed", "section": "swot-validation", "label": "Stress-test description", "kind": "text", "default": "With 20% fewer visits, 20% higher opening capex and staffing held constant, the forecast falls below its three-month reserve in **month {reserveBreach}** and cash turns negative in **month {cashShortfall}** at {funding} of modelled funding."},
  {"id": "seed.competitor-analysis.chapter", "page": "seed", "section": "competitor-analysis", "label": "Slide label", "kind": "text", "default": "Appendix · East Village competition"},
  {"id": "seed.competitor-analysis.heading", "page": "seed", "section": "competitor-analysis", "label": "Slide heading", "kind": "text", "default": "All-day neighbours."},
  {"id": "seed.competitor-analysis.intro", "page": "seed", "section": "competitor-analysis", "label": "Introduction", "kind": "text", "default": "East Village cafés already serve several of the occasions Plaisir is designed for, from the morning coffee run to drinks with friends."},
  {"id": "seed.competitor-analysis.venue.1.name", "page": "seed", "section": "competitor-analysis", "label": "Venue 1 name", "kind": "text", "default": "Café Maud"},
  {"id": "seed.competitor-analysis.venue.1.url", "page": "seed", "section": "competitor-analysis", "label": "Venue 1 url", "kind": "link", "default": "https://www.cafemaud.com/"},
  {"id": "seed.competitor-analysis.venue.1.role", "page": "seed", "section": "competitor-analysis", "label": "Venue 1 role", "kind": "text", "default": "Direct all-day competitor"},
  {"id": "seed.competitor-analysis.venue.1.offering", "page": "seed", "section": "competitor-analysis", "label": "Venue 1 offering", "kind": "text", "default": "A morning coffee window, breakfast and brunch, dinner, cocktails and a speakeasy."},
  {"id": "seed.competitor-analysis.venue.1.hypothesis", "page": "seed", "section": "competitor-analysis", "label": "Venue 1 hypothesis", "kind": "text", "default": "Can fast specialty coffee and a wine-led evening earn visits when guests already have a morning-to-late-night option?"},
  {"id": "seed.competitor-analysis.venue.2.name", "page": "seed", "section": "competitor-analysis", "label": "Venue 2 name", "kind": "text", "default": "MUD / Mudspot"},
  {"id": "seed.competitor-analysis.venue.2.url", "page": "seed", "section": "competitor-analysis", "label": "Venue 2 url", "kind": "link", "default": "https://www.mudnyc.com/pages/mudspot"},
  {"id": "seed.competitor-analysis.venue.2.role", "page": "seed", "section": "competitor-analysis", "label": "Venue 2 role", "kind": "text", "default": "Direct all-day competitor"},
  {"id": "seed.competitor-analysis.venue.2.offering", "page": "seed", "section": "competitor-analysis", "label": "Venue 2 offering", "kind": "text", "default": "An established neighbourhood coffee brand with all-day brunch, beer and wine, and garden seating."},
  {"id": "seed.competitor-analysis.venue.2.hypothesis", "page": "seed", "section": "competitor-analysis", "label": "Venue 2 hypothesis", "kind": "text", "default": "Can Plaisir build a morning routine of its own and give those regulars a reason to return for wine and boards?"},
  {"id": "seed.competitor-analysis.venue.3.name", "page": "seed", "section": "competitor-analysis", "label": "Venue 3 name", "kind": "text", "default": "Marylou"},
  {"id": "seed.competitor-analysis.venue.3.url", "page": "seed", "section": "competitor-analysis", "label": "Venue 3 url", "kind": "link", "default": "https://marylou.nyc/"},
  {"id": "seed.competitor-analysis.venue.3.role", "page": "seed", "section": "competitor-analysis", "label": "Venue 3 role", "kind": "text", "default": "Direct social-occasion competitor"},
  {"id": "seed.competitor-analysis.venue.3.offering", "page": "seed", "section": "competitor-analysis", "label": "Venue 3 offering", "kind": "text", "default": "A French-inspired café, bistro and speakeasy with lunch from noon, weekend brunch, sharing plates, wine and cocktails."},
  {"id": "seed.competitor-analysis.venue.3.hypothesis", "page": "seed", "section": "competitor-analysis", "label": "Venue 3 hypothesis", "kind": "text", "default": "Can early coffee lead to evening visits, and will a glass and a board suit guests who want a shorter visit?"},
  {"id": "seed.competitor-analysis.columns.venue", "page": "seed", "section": "competitor-analysis", "label": "Venue column heading", "kind": "text", "default": "Venue"},
