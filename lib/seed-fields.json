  {"id": "seed.competitor-benchmarks.venue.1.offering", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 1 offering", "kind": "text", "default": "Specialty coffee, a bakery and a design identity rooted in Aarhus."},
  {"id": "seed.competitor-benchmarks.venue.1.hypothesis", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 1 hypothesis", "kind": "text", "default": "Can coffee quality, queue speed and the value of a coffee-and-pastry pairing earn repeat morning visits?"},
  {"id": "seed.competitor-benchmarks.venue.2.name", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 2 name", "kind": "text", "default": "Ruffian"},
  {"id": "seed.competitor-benchmarks.venue.2.url", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 2 url", "kind": "link", "default": "https://ruffiannyc.com/"},
  {"id": "seed.competitor-benchmarks.venue.2.role", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 2 role", "kind": "text", "default": "Wine discovery benchmark"},
  {"id": "seed.competitor-benchmarks.venue.2.offering", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 2 offering", "kind": "text", "default": "A deep Eastern European natural-wine list, seasonal food and guided pairings."},
  {"id": "seed.competitor-benchmarks.venue.2.hypothesis", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 2 hypothesis", "kind": "text", "default": "Can staff help a guest find a glass they’ll enjoy in a short conversation and give them a reason to return?"},
  {"id": "seed.competitor-benchmarks.venue.3.name", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 3 name", "kind": "text", "default": "DiVin"},
  {"id": "seed.competitor-benchmarks.venue.3.url", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 3 url", "kind": "link", "default": "https://www.divinwinebar.com/"},
  {"id": "seed.competitor-benchmarks.venue.3.role", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 3 role", "kind": "text", "default": "Wine and small plates competitor"},
  {"id": "seed.competitor-benchmarks.venue.3.offering", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 3 offering", "kind": "text", "default": "A French-focused cellar and tapas on Second Avenue."},
  {"id": "seed.competitor-benchmarks.venue.3.hypothesis", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 3 hypothesis", "kind": "text", "default": "Will by-the-glass guidance, shareable boards and familiarity from daytime visits bring guests back after work?"},
  {"id": "seed.competitor-benchmarks.source", "page": "seed", "section": "competitor-benchmarks", "label": "Source note", "kind": "text", "default": "Plaisir’s opportunity is to earn both the morning coffee and the evening wine visit from the same regular. The Plaisir Bible’s wider Manhattan comparisons provide context. Venue links document the local offerings."},
  {"id": "seed.competitor-benchmarks.columns.venue", "page": "seed", "section": "competitor-benchmarks", "label": "Venue column heading", "kind": "text", "default": "Venue"},
