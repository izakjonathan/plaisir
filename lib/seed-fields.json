  {"id": "seed.competitor-benchmarks.chapter", "page": "seed", "section": "competitor-benchmarks", "label": "Slide label", "kind": "text", "default": "Appendix · East Village competition"},
  {"id": "seed.competitor-benchmarks.heading", "page": "seed", "section": "competitor-benchmarks", "label": "Slide heading", "kind": "text", "default": "Coffee and wine specialists."},
  {"id": "seed.competitor-benchmarks.intro", "page": "seed", "section": "competitor-benchmarks", "label": "Introduction", "kind": "text", "default": "The East Village also has specialists that set the bar for coffee quality, wine discovery and a glass with food."},
  {"id": "seed.competitor-benchmarks.venue.1.name", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 1 name", "kind": "text", "default": "La Cabra"},
  {"id": "seed.competitor-benchmarks.venue.1.url", "page": "seed", "section": "competitor-benchmarks", "label": "Venue 1 url", "kind": "link", "default": "https://us.lacabra.com/pages/east-village"},
