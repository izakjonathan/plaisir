  {"id": "seed.demand.p.1", "page": "seed", "section": "demand", "label": "Paragraph 1", "kind": "text", "default": "The brand, service plan and interactive app prototype are in place. The flagship is pre-launch."},
  {"id": "seed.demand.item.1.heading", "page": "seed", "section": "demand", "label": "Item 1 heading", "kind": "text", "default": "Run two paid pilots"},
  {"id": "seed.demand.item.1.text", "page": "seed", "section": "demand", "label": "Item 1 text", "kind": "text", "default": "Work with a neighbourhood partner to host a morning coffee pop-up and a small guided wine tasting. Use the morning receipt to invite guests back for the tasting."},
  {"id": "seed.demand.item.2.heading", "page": "seed", "section": "demand", "label": "Item 2 heading", "kind": "text", "default": "Measure the return visit"},
  {"id": "seed.demand.item.2.text", "page": "seed", "section": "demand", "label": "Item 2 text", "kind": "text", "default": "Track paid visits by daypart, average spend, morning service speed, how guests heard about us and how many coffee guests pay to return. Record the cost of any reward."},
  {"id": "seed.demand.item.3.heading", "page": "seed", "section": "demand", "label": "Item 3 heading", "kind": "text", "default": "Decide what to repeat"},
  {"id": "seed.demand.item.3.text", "page": "seed", "section": "demand", "label": "Item 3 text", "kind": "text", "default": "Use the results to choose which offers to carry into the flagship. A winemaker’s night is one format to test for repeat visits."},
