  {"id": "seed.competitor-benchmarks.columns.test", "page": "seed", "section": "competitor-benchmarks", "label": "Test column heading", "kind": "text", "default": "What Plaisir has to prove"},
  {"id": "seed.additional-revenue.chapter", "page": "seed", "section": "additional-revenue", "label": "Slide label", "kind": "text", "default": "Appendix · Future revenue tests"},
  {"id": "seed.additional-revenue.heading", "page": "seed", "section": "additional-revenue", "label": "Slide heading", "kind": "text", "default": "Additional revenue to test."},
  {"id": "seed.additional-revenue.p.1", "page": "seed", "section": "additional-revenue", "label": "Paragraph 1", "kind": "text", "default": "Once daily service is established, test a defined event package and track bookings, staff hours and contribution per event."},
  {"id": "seed.additional-revenue.p.2", "page": "seed", "section": "additional-revenue", "label": "Paragraph 2", "kind": "text", "default": "The flagship sales forecast excludes membership, private events and catering."},
  {"id": "seed.additional-revenue.item.1.heading", "page": "seed", "section": "additional-revenue", "label": "Item 1 heading", "kind": "text", "default": "Private tastings"},
  {"id": "seed.additional-revenue.item.1.text", "page": "seed", "section": "additional-revenue", "label": "Item 1 text", "kind": "text", "default": "Test a small guided tasting with wine and food pairings."},
  {"id": "seed.additional-revenue.item.2.heading", "page": "seed", "section": "additional-revenue", "label": "Item 2 heading", "kind": "text", "default": "Milestone Moments"},
  {"id": "seed.additional-revenue.item.2.text", "page": "seed", "section": "additional-revenue", "label": "Item 2 text", "kind": "text", "default": "Approach companies ahead of an anniversary with a tailored event package. Follow up for repeat bookings and referrals."},
  {"id": "seed.additional-revenue.item.3.heading", "page": "seed", "section": "additional-revenue", "label": "Item 3 heading", "kind": "text", "default": "Off-site hospitality"},
  {"id": "seed.additional-revenue.item.3.text", "page": "seed", "section": "additional-revenue", "label": "Item 3 text", "kind": "text", "default": "Test coffee or wine service for offices and conferences."},
  {"id": "seed.second-location.chapter", "page": "seed", "section": "second-location", "label": "Slide label", "kind": "text", "default": "Appendix · Expansion playbook"},
  {"id": "seed.second-location.heading", "page": "seed", "section": "second-location", "label": "Slide heading", "kind": "text", "default": "What a second site would inherit."},
  {"id": "seed.second-location.p.1", "page": "seed", "section": "second-location", "label": "Paragraph 1", "kind": "text", "default": "The flagship would build the playbook. A second site would use it once the flagship shows repeat demand and positive cash flow."},
  {"id": "seed.second-location.p.2", "page": "seed", "section": "second-location", "label": "Paragraph 2", "kind": "text", "default": "Franchising is a longer-term option."},
  {"id": "seed.second-location.item.1.heading", "page": "seed", "section": "second-location", "label": "Item 1 heading", "kind": "text", "default": "Service and handover"},
  {"id": "seed.second-location.item.1.text", "page": "seed", "section": "second-location", "label": "Item 1 text", "kind": "text", "default": "Document how the room, bar and staffing change from coffee to wine, along with the service standards for each shift."},
  {"id": "seed.second-location.item.2.heading", "page": "seed", "section": "second-location", "label": "Item 2 heading", "kind": "text", "default": "Training and sourcing"},
  {"id": "seed.second-location.item.2.text", "page": "seed", "section": "second-location", "label": "Item 2 text", "kind": "text", "default": "Record how staff learn both services and what suppliers need to deliver, including seasonal sourcing specifications."},
  {"id": "seed.second-location.item.3.heading", "page": "seed", "section": "second-location", "label": "Item 3 heading", "kind": "text", "default": "Stock and waste"},
  {"id": "seed.second-location.item.3.text", "page": "seed", "section": "second-location", "label": "Item 3 text", "kind": "text", "default": "Document weekly inventory audits, stock rotation and how the team records waste."}
]
