  {"id": "seed.guests.p.1", "page": "seed", "section": "guests", "label": "Paragraph 1", "kind": "text", "default": "Plaisir is designed for people who live or work within walking distance of the flagship."},
  {"id": "seed.guests.p.2", "page": "seed", "section": "guests", "label": "Paragraph 2", "kind": "text", "default": "Afternoon coffee and light lunch give regulars another reason to return."},
  {"id": "seed.guests.item.1.heading", "page": "seed", "section": "guests", "label": "Item 1 heading", "kind": "text", "default": "Morning coffee"},
  {"id": "seed.guests.item.1.text", "page": "seed", "section": "guests", "label": "Item 1 text", "kind": "text", "default": "Nearby workers and residents looking for a reliable espresso and pastry, with a quick takeaway option."},
  {"id": "seed.guests.item.2.heading", "page": "seed", "section": "guests", "label": "Item 2 heading", "kind": "text", "default": "Evening wine"},
  {"id": "seed.guests.item.2.text", "page": "seed", "section": "guests", "label": "Item 2 text", "kind": "text", "default": "After-work guests and local wine drinkers looking for a relaxed table, guided choices and food to share."},
  {"id": "seed.concept.chapter", "page": "seed", "section": "concept", "label": "Slide label", "kind": "text", "default": "The Plaisir experience"},
  {"id": "seed.concept.heading", "page": "seed", "section": "concept", "label": "Slide heading", "kind": "text", "default": "One room, from coffee to wine."},
  {"id": "seed.concept.item.1.heading", "page": "seed", "section": "concept", "label": "Item 1 heading", "kind": "text", "default": "Morning"},
  {"id": "seed.concept.item.1.text", "page": "seed", "section": "concept", "label": "Item 1 text", "kind": "text", "default": "A quick espresso and pastry on the way to work. Staff keep the counter moving and learn what regulars order."},
  {"id": "seed.concept.item.2.heading", "page": "seed", "section": "concept", "label": "Item 2 heading", "kind": "text", "default": "Afternoon"},
  {"id": "seed.concept.item.2.text", "page": "seed", "section": "concept", "label": "Item 2 text", "kind": "text", "default": "Serve light lunch and coffee. As the day shifts, change the lighting and music, set the bar for wine and adjust staffing."},
  {"id": "seed.concept.item.3.heading", "page": "seed", "section": "concept", "label": "Item 3 heading", "kind": "text", "default": "Evening"},
  {"id": "seed.concept.item.3.text", "page": "seed", "section": "concept", "label": "Item 3 text", "kind": "text", "default": "Pour wine by the glass, guide guests through flights and serve boards to share. Explain the wines in everyday language and keep the room quiet enough for conversation."},
