  {"id": "seed.team-model.p.2", "page": "seed", "section": "team-model", "label": "Paragraph 2", "kind": "text", "default": "The flagship forecast includes paid training, leave cover, health and dental/vision coverage allowances, and retirement and incentive provisions."},
